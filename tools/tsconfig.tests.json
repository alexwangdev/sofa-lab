{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../dist/types/tests",
    "tsBuildInfoFile": "../dist/types/tests/tsconfig.tsbuildinfo",
    "types": [
      "node"
    ],
    "rootDir": "..",
    "lib": [
      "DOM",
      "ES2023"
    ]
  },
  "include": [
    "../tests/**/*",
    "../tools/**/*.ts"
  ],
  "references": [
    {
      "path": "./tsconfig.shared.json"
    },
    {
      "path": "./tsconfig.server.json"
    },
    {
      "path": "./tsconfig.client.json"
    }
  ]
}