{
  "private": true,
  "name": "grid-expedition",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run atlas && tsc --build && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --build",
    "test": "node --experimental-strip-types --no-warnings=ExperimentalWarning tests/acceptance.ts",
    "atlas": "node --experimental-strip-types --no-warnings=ExperimentalWarning tools/bake-atlas.ts",
    "predev": "npm run atlas",
    "autotest": "node --experimental-strip-types --no-warnings=ExperimentalWarning tools/autotest.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "hono": "4.13.17",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "^24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.7"
  }
}
